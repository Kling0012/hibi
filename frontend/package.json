{
  "name": "MineContext",
  "version": "0.1.5",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "installConfig": {
      "hoistingLimits": [
        "packages/database"
      ]
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "build:externals": "node -e \"if(process.platform!=='win32')require('child_process').execSync('chmod +x build-python.sh')\"",
    "dev": "electron-vite dev",
    "build:dev": "npm run copy-backend && npm run build && electron-vite dev",
    "build": "npm run build:externals && node build-python.js && npm run typecheck && node -e \"if(process.platform==='win32'){require('fs').rmSync('./dist',{recursive:true,force:true})}else{require('child_process').execSync('rm -rf ./dist')}\" && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run copy-backend && npm run build && electron-builder --win",
    "build:mac": "npm run copy-backend && npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "publish": "npm run copy-backend && npm run build && electron-builder --mac --win -p always",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "copy-backend": "node scripts/copy-prebuilt-backend.js",
    "electron-pack": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/react": "^4.0.140",
    "@arco-design/color": "0.4.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-avatar": "^1.3.0",
    "@radix-ui/react-collapsible": "^1.2.0",
    "@radix-ui/react-hover-card": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@zhongyao/heatmap": "^0.0.6",
    "ahooks": "^3.10.0",
    "ai": "^7.0.137",
    "allotment": "^1.20.5",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.3.0",
    "jotai": "^2.20.3",
    "lucide-react": "^0.542.0",
    "mitt": "^3.0.1",
    "node-cron": "^4.6.0",
    "node-screenshots": "^0.2.8",
    "os-proxy-config": "^1.1.2",
    "pidusage": "^4.0.1",
    "react-arborist": "^3.16.0",
    "react-syntax-highlighter": "^15.6.6",
    "remove-markdown": "^0.6.4",
    "screenshot-desktop": "^1.15.7",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "node-screenshots-darwin-arm64": "0.2.8",
    "node-screenshots-darwin-x64": "0.2.8",
    "node-screenshots-linux-x64-gnu": "0.2.8",
    "node-screenshots-win32-x64-msvc": "0.2.8"
  },
  "devDependencies": {
    "@arco-design/web-react": "^2.66.18",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^2.5.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@milkdown/react": "^7.22.3",
    "@reduxjs/toolkit": "^2.13.0",
    "@swc/plugin-styled-components": "^7.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash": "^4.17.26",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "axios": "^1.20.0",
    "chardet": "^2.2.0",
    "code-inspector-plugin": "^0.20.17",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fetch-socks": "1.3.2",
    "highlight.js": "^11.12.0",
    "iconv-lite": "^0.6.3",
    "less": "^4.9.1",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.2",
    "p-queue": "^8.1.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-sort-json": "^4.2.0",
    "proxy-agent": "^6.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hotkeys-hook": "^4.6.2",
    "react-i18next": "^14.1.3",
    "react-redux": "^9.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "6.21.2",
    "uuid": "^10.0.0",
    "vite": "^7.3.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "esbuild"
    ]
  }
}