# Gateway
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8377
MEMORY_BIND_ADDRESS=127.0.0.1
MEMORY_PUBLISHED_PORT=8377
MEMORY_DEFAULT_USER=default
MEMORY_DEFAULT_PROJECT=all
MEMORY_DEFAULT_AGENT=codex
MEMORY_SESSION_TTL_SECONDS=86400
MEMORY_ADMIN_TOKEN=
# Extra hosts (comma-separated) the MCP endpoint accepts, beyond localhost.
# Required when agents connect from other machines, e.g. MCP_ALLOWED_HOSTS=memory.example.internal
#MCP_ALLOWED_HOSTS=

# Backends (Docker Compose defaults)
VALKEY_URL=redis://valkey:6379/0
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_DATABASE=agent_memory

# Graph extraction uses an OpenAI-compatible API. Embedding modes are local,
# cloudflare (no local fallback), and cloudflare_primary_local_fallback.
# Select cloudflare when the local embedding service is intentionally stopped.
# Replace the base URL and key with the selected provider. Planned model: GLM-5.3-Flash.
MEMORY_LLM_PROVIDER=openai_compatible
MEMORY_LLM_BASE_URL=https://provider.example/v1
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
MEMORY_EMBEDDING_API_KEY=local-embedding
MEMORY_EMBEDDING_MODE=local
MEMORY_EMBEDDING_CLOUDFLARE_MODEL=@cf/qwen/qwen3-embedding-0.6b
MEMORY_EMBEDDING_CLOUDFLARE_TIMEOUT_SECONDS=15
# The production stability overlay explicitly uses 60 seconds via Compose.
MEMORY_EMBEDDING_FALLBACK_COOLDOWN_SECONDS=300
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MEMORY_LLM_MODEL=glm-5.3-flash
MEMORY_LLM_SMALL_MODEL=glm-5.3-flash
MEMORY_LLM_MAX_TOKENS=2048
MEMORY_LLM_STRUCTURED_OUTPUT_MODE=json_schema
# Bound concurrent extraction calls to avoid provider rate limits.
MEMORY_GRAPHITI_SEMAPHORE_LIMIT=3
# graphiti: synchronous standard pipeline
# graphiti_async: durable canonical accept + resumable standard Graphiti worker
# typesafe_async: experimental pre-resolved direct writer
MEMORY_INGESTION_MODE=graphiti
MEMORY_NODE_RESOLUTION_PROVIDER=jev
MEMORY_NODE_PARTIAL_FALLBACK_MODE=off
# typesafe uses the official API. adapter targets a System One compatible endpoint.
MEMORY_DECISION_BACKEND=typesafe
MEMORY_DECISION_ADAPTER_BASE_URL=
MEMORY_DECISION_ADAPTER_API_KEY=
MEMORY_DECISION_ADAPTER_MODEL=
MEMORY_JEV_TIMEOUT_SECONDS=20
MEMORY_JEV_BATCH_SIZE=40
MEMORY_JEV_MAX_CONCURRENCY=3
MEMORY_JEV_CACHE_MAX_ENTRIES=256
MEMORY_JEV_CACHE_TTL_SECONDS=300
TYPESAFE_API_KEY=
MEMORY_TYPESAFE_MODEL=jev-1.13.0
MEMORY_DECISION_CONFIDENCE=0.90
MEMORY_SEARCH_RERANK_MODE=off
MEMORY_SEARCH_RERANK_CANDIDATES=15
MEMORY_SEARCH_RERANK_BATCH_SIZE=20
MEMORY_SEARCH_RERANK_TIMEOUT_SECONDS=20
MEMORY_ENRICHMENT_TIMEOUT_SECONDS=180
MEMORY_ENRICHMENT_LEASE_SECONDS=240
MEMORY_ENRICHMENT_POLL_SECONDS=1
MEMORY_ENRICHMENT_MAX_ATTEMPTS=3
MEMORY_EMBEDDING_MODEL=qwen3-embedding-0.6b
MEMORY_EMBEDDING_DIM=1024
MEMORY_LLM_API_KEY=
# Backward-compatible fallback for an OpenAI account.
OPENAI_API_KEY=
GRAPHITI_TELEMETRY_ENABLED=false
