# hibi-server 本番用設定の例 / Example production settings for hibi-server
# 使い方 / How to use:
#   cp .env.example .env
# 上から順に埋めていく。必須は「1. LLM の接続先」だけで、ほかは既定のままでも動く。
# Fill it in top to bottom. Only section 1 (the LLM endpoint) is required;
# every other section works with its default value.
# 秘密の値はこのファイルに書かず、secrets/ 下のファイルで渡す。
# Never put secret values in this file — pass them as files under secrets/.

# ── 1. LLM の接続先（必須）/ LLM endpoint (required) ─────────────────────
# OpenAI 互換のベース URL（…/v1 まで）。作業の終了判定・日報・ブログ生成に使う。
# OpenAI-compatible base URL (up to .../v1). Used for session-end judging,
# daily reports and blog generation.
LLM_BASE_URL=
# LLM モデル名（接続先が提供するモデルに合わせる）/ Model name your endpoint serves
LLM_MODEL=glm-5.3-flash
# API キーファイルのホスト側パス（中身はキー 1 行。README の手順で作る）
# Host-side path of a one-line API-key file (created in the README steps)
LLM_KEY_FILE=./secrets/llm-key

# ── 2. 待ち受けアドレス（任意）/ Listen address (optional) ───────────────
# 既定では 127.0.0.1 のみ（サーバ 1 台で完結）。他の端末から同期するときは、
# Tailscale などの閉じた網でのサーバの IP に変える。インターネットには直接出さない。
# Default binds 127.0.0.1 only (server-only use). To sync from other devices,
# set this to the server's IP on a closed network such as a Tailscale tailnet.
# Never expose the API directly to the internet.
# 旧名 PROD_TAILNET_IP を .env に書いてあれば、そちらが優先される。
# The legacy name PROD_TAILNET_IP, when set, takes precedence over BIND_ADDR.
BIND_ADDR=127.0.0.1
# 待ち受けポート / Port to listen on
PROD_PORT=18740

# ── 3. 意味検索（任意）/ Semantic search (optional) ──────────────────────
# 埋め込みを使わないなら fake のまま。外部への通信はなく、検索は全文一致のみで動く。
# Keep "fake" to skip embeddings: no external calls; full-text search only.
# Cloudflare Workers AI で意味検索を使うときは:
#   1) EMBED_PROVIDER=cloudflare
#   2) secrets/cloudflare.env に次の 2 行を書く:
#        CLOUDFLARE_ACCOUNT_ID=...
#        CLOUDFLARE_API_TOKEN=...
# To enable it with Cloudflare Workers AI, set EMBED_PROVIDER=cloudflare and put
# those two lines into secrets/cloudflare.env.
EMBED_PROVIDER=fake
# Cloudflare 用秘密ファイルのホスト側パス / Host-side path of the Cloudflare credential file
CF_ENV_FILE=./secrets/cloudflare.env

# ── 4. AI の作業記録の取り込み（任意）/ AI work import (optional) ────────
# agent-memory（hibi-memory）のベース URL。空なら取り込みはアイドルのまま。
# Base URL of agent-memory (hibi-memory); leave empty to keep the importer idle.
AM_BASE_URL=

# ── 5. 生成記事の扱い（任意）/ Generated posts (optional) ────────────────
# AI が生成する記事の既定 status（off=生成しない / draft=下書き / publish=即公開）
# Default status of AI-generated posts (off / draft / publish)
BLOG_AUTO=draft

# ── 6. その他（任意）/ Miscellaneous (optional) ──────────────────────────
# compose project 名（コンテナ名・ネットワーク名の接頭辞）/ Compose project name
COMPOSE_PROJECT_NAME=hibi
# DB 用ボリュームの固定名（バックアップ・検査で使う）/ Fixed DB volume name
PGDATA_VOLUME=hibi-pgdata
# 既定タイムゾーン（日報・日別集計の日の境界）/ Default timezone for reports and stats
TZ_DEFAULT=Asia/Tokyo
# 日報生成に使う LLM モデル / Model used for daily report generation
REPORT_LLM_MODEL=glm-5.3
# 日報の要約に使う軽量モデル / Light model for report pre-summarization
REPORT_LLM_FLASH_MODEL=glm-5.3-flash
# バックアップ保存先（scripts/backup.sh）/ Backup destination (scripts/backup.sh)
BACKUP_DIR=./backups
# バックアップ保持日数（これより古い hibi-*.dump を削除）/ Backup retention days
KEEP_DAYS=14

# ── 7. 動作の調整（任意。既定のままでよい）/ Tuning (optional; defaults are fine) ──
# 実質の離席がこの分以上続くと、宣言した作業を離席開始時刻で終了する
# End a declared session after this many minutes of continuous absence
SESSION_AWAY_END_MINUTES=30
# ToDo 自動計上の照合ジョブ周期（秒）/ Todo matching job interval (seconds)
TODO_JUDGE_INTERVAL=300
# 計上に採用する LLM の confidence しきい値 / Minimum LLM confidence to record
TODO_MATCH_THRESHOLD=0.7
# 1 回の照合で見る窓の上限（分）/ Matching window cap per cycle (minutes)
TODO_JUDGE_MAX_WINDOW_MIN=30
# 同じ ToDo の直前の計上との隙間がこの分以内なら延長する / Merge gap (minutes)
TODO_MERGE_GAP_MIN=5

# 日報・ブログ本文を保存前に yomiyasu で点検し、LLM で1回だけ書き直す（0 で無効）
# Polish Japanese daily-report/blog bodies with yomiyasu before saving (0 = off)
YOMIYASU_POLISH=1
